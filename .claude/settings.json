{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:full)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop-check.sh",
            "timeout": 180,
            "statusMessage": "Running the project checks"
          }
        ]
      }
    ]
  }
}
